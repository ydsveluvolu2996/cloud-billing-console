SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Web host only. Six-hour scheduling lives on the separate collector systemd service.
30 2 * * * root /opt/cloud-billing/deploy/backup.sh >> /var/log/cloud-billing-backup.log 2>&1
15 3 * * * root cd /opt/cloud-billing && docker compose exec -T app python manage.py clearsessions >> /var/log/cloud-billing-maintenance.log 2>&1
