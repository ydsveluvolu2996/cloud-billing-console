{$DASHBOARD_HOST} {$DASHBOARD_ALIASES} {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    @alias not host {$DASHBOARD_HOST}
    redir @alias https://{$DASHBOARD_HOST}{uri} 308
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
    }
    # The invoice file is limited to 2 MiB by the application; allow its
    # multipart form envelope without increasing limits on other endpoints.
    @invoice_upload path /reconciliation/
    request_body @invoice_upload {
        max_size 3MB
    }
    @other_requests not path /reconciliation/
    request_body @other_requests {
        max_size 1MB
    }
    reverse_proxy app:8000
}
