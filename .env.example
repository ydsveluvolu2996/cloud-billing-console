DEBUG=false
SECRET_KEY=generate-a-long-random-value
DB_PASSWORD=generate-a-different-random-value
DASHBOARD_HOST=billing.example.com
ALLOWED_HOSTS=billing.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://billing.example.com
AWS_REGION=ap-south-1
COLLECTOR_ROLE_ARN=arn:aws:iam::123456789012:role/CloudBillingCollector
ARTIFACT_BUCKET=your-private-billing-artifacts
HISTORY_MONTHS=6
# Worker and AWS request limits (optional; defaults shown)
WORKER_CONCURRENCY=3
SCHEDULE_JITTER_SECONDS=900
MAX_REQUESTS_PER_JOB=400
AWS_REQUEST_INTERVAL_SECONDS=0
BUDGET_AWS_FORECASTS=true
