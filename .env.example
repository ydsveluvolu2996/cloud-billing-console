# Non-secret Compose configuration only. Stage restricted secret files separately.
DASHBOARD_HOST=billing.example.com
DASHBOARD_ALIASES=
PRIVATE_DB_IP=10.0.1.10
AWS_REGION=ap-south-1
COLLECTOR_ROLE_ARN=arn:aws:iam::123456789012:role/CloudBillingCollector
AUDIT_LOG_GROUP=/cloud-billing/APPROVED_STACK/security
# Compose intentionally defaults external access and live delivery to disabled.
# Runtime/SSO/collector configuration: docs/deployment-runbook.md
